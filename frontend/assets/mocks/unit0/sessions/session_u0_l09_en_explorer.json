      "block_id": "b_u0_l09_03",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Start with the actual claim"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l09_005",
            "spans": [
              {
                "type": "text",
                "text": "The Qur'an describes itself as sent down by the Lord of all worlds, rather than human authorship."
              }
            ],
            "source_ids": [
              "src_c_u0_l09_01"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l09_006",
            "spans": [
              {
                "type": "text",
                "text": "A book's account of its source identifies its claim, but does not establish that claim by itself."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l09_007",
            "spans": [
              {
                "type": "text",
                "text": "Keep two questions separate: what does the text say, and what supports its truth?"
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l09_008",
            "spans": [
              {
                "type": "text",
                "text": "Evidence examining a claim needs to add something beyond repeating the same claim."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
