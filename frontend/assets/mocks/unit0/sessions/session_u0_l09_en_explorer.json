      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l09_016",
            "spans": [
              {
                "type": "text",
                "text": "The Qur'an describes itself as guidance, beyond offering a reader a literary experience."
              }
            ],
            "source_ids": [
              "src_c_u0_l09_04"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l09_017",
            "spans": [
              {
                "type": "text",
                "text": "It describes its relationship to earlier scriptures as confirming them and having authority over them."
              }
            ],
            "source_ids": [
              "src_c_u0_l09_05"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l09_018",
            "spans": [
              {
                "type": "text",
                "text": "It presents its preservation as a promise from God within the text."
              }
            ],
            "source_ids": [
              "src_c_u0_l09_06"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l09_019",
            "spans": [
              {
                "type": "text",
                "text": "A preservation claim differs from studying how the text was transmitted over time."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_5",
          "sentence": {
            "sentence_id": "s_u0_l09_020",
            "spans": [
              {
                "type": "text",
                "text": "For preservation, look at evidence of transmission; for the message, read what the text asks of its reader."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
