      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l09_022",
            "spans": [
              {
                "type": "text",
                "text": "The Qur'an challenges those doubting its source to produce a surah like it."
              }
            ],
            "source_ids": [
              "src_c_u0_l09_08"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l09_023",
            "spans": [
              {
                "type": "text",
                "text": "Understanding the challenge requires knowing what likeness means and how an attempted response would be assessed."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l09_024",
            "spans": [
              {
                "type": "text",
                "text": "Reading a translation alone does not allow examination of every feature of the original Arabic text."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l09_025",
            "spans": [
              {
                "type": "text",
                "text": "Ask for the criteria and examples of their application, beyond saying that you liked or disliked the text."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
