    {
      "block_id": "b_u0_l01_07",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "The routes you just used"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l01_016",
            "spans": [
              {
                "type": "text",
                "text": "Direct observation includes more than sight. You sense the cup’s warmth through touch."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l01_017",
            "spans": [
              {
                "type": "text",
                "text": "Inference connects a trace with an explanation while keeping reasonable alternatives in view."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l01_018",
            "spans": [
              {
                "type": "text",
                "text": "Your grandmother’s report is a third route, if she is truthful and actually looking at the tree."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l01_019",
            "spans": [
              {
                "type": "text",
                "text": "There are two different questions about a source: are they truthful, and are they placed to know?"
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
