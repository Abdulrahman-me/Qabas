          "combo": true,
          "layer": "apply"
        },
        "framing": null,
        "payload": {
          "options": [
            {
              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "Believe it because he speaks confidently."
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "Check the source’s identity and evidence, and consult a qualified professional before a health decision."
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "Reject every report from one person."
                }
              ]
            }
          ],
          "situation": [
            {
              "type": "text",
              "text": "Imagine a clip of an unnamed man claiming that a herbal drink can replace diabetes medication."
            }
          ]
        }
      }
    },
    {
      "block_id": "b_u0_l01_14",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "What can you now do?"
        }
      ],
      "style": "summary",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l01_036",
            "spans": [
              {
                "type": "text",
                "text": "Ask whether you sensed this yourself, inferred it, or received a report."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l01_037",
            "spans": [
              {
                "type": "text",
                "text": "Separate a trace from its interpretation, and choose wording that matches your evidence."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l01_038",
            "spans": [
              {
                "type": "text",
                "text": "Check the source’s truthfulness and access, and investigate more carefully when the stakes grow."
              }
            ],
            "source_ids": []
