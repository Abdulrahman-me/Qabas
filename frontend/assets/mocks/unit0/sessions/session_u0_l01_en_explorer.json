              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "He checked the current operating record available to him."
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "The latest report is always right."
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "The passenger must have been lying."
                }
              ]
            }
          ]
        }
      }
    },
    {
      "block_id": "b_u0_l01_11",
      "type": "predict",
      "prompt": [
        {
          "type": "text",
          "text": "Which report would you check more carefully?"
        }
      ],
      "options": [
        {
          "option_id": "opt_a",
          "spans": [
            {
              "type": "text",
              "text": "A neighbour who uses the bakery tells you its opening time."
            }
          ]
        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "A stranger says the tap water is unsafe today."
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "I would check both equally."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "Consider the source’s access, the stakes of the decision, and whether the report is unusual."
        }
      ],
      "visual": null
    },
    {
      "block_id": "b_u0_l01_12",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Checking that fits the decision"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l01_031",
            "spans": [
              {
                "type": "text",
                "text": "An ordinary report from someone truthful and placed to know may be enough for a simple decision."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l01_032",
            "spans": [
              {
                "type": "text",
                "text": "As the consequences grow, you need clearer evidence. Confidence in a voice is not verification."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l01_033",
            "spans": [
              {
                "type": "text",
                "text": "For the water report, look for a notice from the relevant local authority instead of relying on an anonymous warning."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l01_034",
            "spans": [
              {
                "type": "text",
                "text": "Asking for verification does not accuse the speaker of lying. They may be honest but uninformed."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_u0_l01_13",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l01_05",
        "type": "scenario",
        "concept_ids": [
          "con_u0_knowledge_routes",
          "con_u0_evidence_limits"
        ],
        "prompt": [
