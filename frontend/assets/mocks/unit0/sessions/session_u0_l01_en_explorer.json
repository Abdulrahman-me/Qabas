        "alt": "A closed box with a blank label at a house door.",
        "overlays": []
      },
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l01_005",
            "spans": [
              {
                "type": "text",
                "text": "Imagine stepping outside and finding a closed box at your door, with a label bearing your name."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 0
          }
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l01_006",
            "spans": [
              {
                "type": "text",
                "text": "What you observed was the box and label. You did not see anyone bring it."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l01_007",
            "spans": [
              {
                "type": "text",
                "text": "In this ordinary situation, the parcel strongly supports the conclusion that someone brought it."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l01_008",
            "spans": [
              {
                "type": "text",
                "text": "It may reasonably be your expected order, but the label alone does not reveal its contents."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        },
        {
          "point_id": "p_5",
          "sentence": {
            "sentence_id": "s_u0_l01_009",
            "spans": [
              {
                "type": "text",
                "text": "The evidence identifies neither the person who brought it nor its arrival time. Those are separate questions."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        }
      ]
    },
    {
      "block_id": "b_u0_l01_04",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l01_01",
        "type": "multiple_choice",
        "concept_ids": [
          "con_u0_knowledge_routes",
          "con_u0_evidence_limits"
        ],
        "prompt": [
          {
            "type": "text",
            "text": "Which statement separates observation from inference?"
          }
        ],
        "time_limit_ms": null,
        "scoring": {
          "accuracy": true,
          "combo": true,
          "layer": "apply"
        },
        "framing": null,
        "payload": {
          "options": [
            {
              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "I saw a delivery worker place it, because the box is there."
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "I observed a box and inferred that someone brought it."
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "I saw the contents from my name on the label."
                }
              ]
            }
          ]
        }
      }
    },
