      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l01_011",
            "spans": [
              {
                "type": "text",
                "text": "Imagine a table in a quiet library, with an open book and a cup of tea."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 0
          }
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l01_012",
            "spans": [
              {
                "type": "text",
                "text": "You touch the cup and feel its warmth. You see nobody at the table."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 0
          }
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l01_013",
            "spans": [
              {
                "type": "text",
                "text": "The cup’s warmth is a direct observation. Someone having been here recently is a reasonable inference, not an observation."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l01_014",
            "spans": [
              {
                "type": "text",
                "text": "The tea might be kept warm another way, so the cup alone cannot establish when someone left."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        }
      ]
    },
    {
      "block_id": "b_u0_l01_06",
      "type": "exercise",
      "exercise": {
