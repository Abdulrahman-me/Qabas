    {
      "block_id": "b_u0_l01_01",
      "type": "hook",
      "situation": [
        {
          "type": "text",
          "text": "Imagine your grandmother calls from the village and says the apricot tree you planted has fruit."
        },
        {
          "type": "text",
          "text": " "
        },
        {
          "type": "text",
          "text": "You are far away. She stands beside the tree, looking at its branches."
        }
      ],
      "question": [
        {
          "type": "text",
          "text": "Must you see it yourself before you can know that it has fruit?"
        }
      ],
      "visual": {
        "kind": "scene",
        "key": null,
        "version": null,
