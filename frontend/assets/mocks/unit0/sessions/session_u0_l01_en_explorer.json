    {
      "block_id": "b_u0_l01_02",
      "type": "predict",
      "prompt": [
        {
          "type": "text",
          "text": "Can you know something you have not seen with your own eyes?"
        }
      ],
      "options": [
        {
          "option_id": "opt_a",
          "spans": [
            {
              "type": "text",
              "text": "Yes, depending on the evidence."
            }
          ]
        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "I need to see it myself."
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "I have not decided."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "Keep your answer in mind and examine three situations before returning to it."
        }
      ],
      "visual": null
    },
    {
