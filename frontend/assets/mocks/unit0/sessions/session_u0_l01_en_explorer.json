        "prompt": [
          {
            "type": "text",
            "text": "Why was the clerk’s answer stronger here?"
          }
        ],
        "time_limit_ms": null,
        "scoring": {
          "accuracy": true,
          "combo": true,
          "layer": "understand"
        },
        "framing": null,
        "payload": {
          "options": [
