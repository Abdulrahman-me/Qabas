      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Ask carefully about gain"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l11_023",
            "spans": [
              {
                "type": "text",
                "text": "The Qur'an presents Muhammad's address as asking for no reward for this message."
              }
            ],
            "source_ids": [
              "src_c_u0_l11_11"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l11_024",
            "spans": [
              {
                "type": "text",
                "text": "A no-reward statement identifies what a claimant says, while examining conduct requires its supporting reports."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l11_025",
            "spans": [
              {
                "type": "text",
                "text": "A reliable report of declining a benefit weakens that particular motive explanation, but does not alone establish prophethood."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l11_026",
            "spans": [
              {
                "type": "text",
                "text": "If you read a story about refusing wealth or power, ask for its source and what its details establish."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
