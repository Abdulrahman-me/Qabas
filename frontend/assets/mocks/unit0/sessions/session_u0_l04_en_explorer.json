            "sentence_id": "s_u0_l04_014",
            "spans": [
              {
                "type": "text",
                "text": "Transferring the flame explains its arrival at a lantern. The scenario’s lanterns are not independent sources of ignition."
              }
            ],
            "source_ids": []
          },
          "visual_params": {
            "beat": 1
          }
        },
