    {
      "block_id": "b_u0_l04_07",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "From an example to a wider question"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l04_018",
            "spans": [
              {
                "type": "text",
                "text": "Suppose things dependent on others for existence need explaining, and we seek a complete explanation of that dependence."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l04_019",
            "spans": [
              {
                "type": "text",
                "text": "Adding another thing dependent in the same way moves the question to it without finishing the explanation."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l04_020",
            "spans": [
              {
                "type": "text",
                "text": "If the final explanation depends on the very things being explained, the dependence we wanted to explain remains."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l04_021",
            "spans": [
              {
                "type": "text",
                "text": "Within this reasoning, a foundation that completes the explanation must not need those things in order to exist."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_5",
          "sentence": {
            "sentence_id": "s_u0_l04_022",
            "spans": [
              {
                "type": "text",
                "text": "Here we ask what explains dependence, rather than only asking about the first event in a timeline."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
