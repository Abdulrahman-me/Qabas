          "option_id": "opt_a",
          "spans": [
            {
              "type": "text",
              "text": "It acknowledges my limited knowledge."
            }
          ]
        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "I might see it as a provisional answer."
