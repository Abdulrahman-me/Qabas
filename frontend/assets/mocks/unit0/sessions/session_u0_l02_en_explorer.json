    {
      "block_id": "b_u0_l02_10",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "What does this reasoning exclude?"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l02_026",
            "spans": [
              {
                "type": "text",
                "text": "If nothing means the absence of everything, it supplies nothing that explains a new existence."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l02_027",
            "spans": [
              {
                "type": "text",
                "text": "This examines “nothing produced something.” It does not turn a difficult question into an account of the universe’s history."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l02_028",
            "spans": [
              {
                "type": "text",
                "text": "We have not established that the universe began, or how it began. Establishing that requires further evidence."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l02_029",
            "spans": [
              {
                "type": "text",
                "text": "Excluding an explanation does not automatically establish every detail of another explanation."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_5",
          "sentence": {
            "sentence_id": "s_u0_l02_030",
            "spans": [
              {
                "type": "text",
                "text": "The remaining question is: if existence needs an explanation, what could do that job?"
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
