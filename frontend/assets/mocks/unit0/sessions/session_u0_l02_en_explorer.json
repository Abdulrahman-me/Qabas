    {
      "block_id": "b_u0_l02_05",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "“Empty” and “nothing at all” differ"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "p_1",
          "sentence": {
            "sentence_id": "s_u0_l02_013",
            "spans": [
              {
                "type": "text",
                "text": "In the scenario, the case, glass, key, and guard still existed even when no vase was inside."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_2",
          "sentence": {
            "sentence_id": "s_u0_l02_014",
            "spans": [
              {
                "type": "text",
                "text": "Here, “empty” means no exhibit inside, rather than the absence of everything."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_3",
          "sentence": {
            "sentence_id": "s_u0_l02_015",
            "spans": [
              {
                "type": "text",
                "text": "In our question, nothing means no thing exists: no place, materials, or working power."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_4",
          "sentence": {
            "sentence_id": "s_u0_l02_016",
            "spans": [
              {
                "type": "text",
                "text": "If you imagine a dark space waiting for something, you have imagined a place, not nothing."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "p_5",
          "sentence": {
            "sentence_id": "s_u0_l02_017",
            "spans": [
              {
                "type": "text",
                "text": "Black in an illustration is only a background. A picture cannot display the absence of everything."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
