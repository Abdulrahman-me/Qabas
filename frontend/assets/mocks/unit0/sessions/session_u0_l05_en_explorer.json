        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "Are there other explanations?"
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "I need time to think."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "Your choices can lead to different questions. Your personal position is not graded."
        },
        {
          "type": "text",
          "text": " "
        },
        {
          "type": "text",
          "text": "A coherent world fits a unified explanation, but coherence alone does not settle the number of creators."
        }
      ],
      "visual": null
    },
    {
      "block_id": "b_synthesis",
      "type": "teach",
      "eyebrow": null,
