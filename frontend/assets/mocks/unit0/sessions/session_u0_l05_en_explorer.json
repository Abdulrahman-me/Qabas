      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "conflict_p0",
          "sentence": {
            "sentence_id": "conflict_s0",
            "spans": [
              {
                "type": "text",
                "text": "Awarding and disallowing the same goal in the same match cannot both take effect."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "conflict_p1",
          "sentence": {
            "sentence_id": "conflict_s1",
            "spans": [
              {
                "type": "text",
                "text": "If a higher rule settles the disagreement, neither referee has final authority."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "conflict_p2",
          "sentence": {
            "sentence_id": "conflict_s2",
            "spans": [
              {
                "type": "text",
                "text": "We could appoint a chief and an assistant, or give each a different task."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "conflict_p3",
          "sentence": {
            "sentence_id": "conflict_s3",
            "spans": [
              {
                "type": "text",
                "text": "Then we have an arrangement for the work, rather than two conflicting final decisions."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
