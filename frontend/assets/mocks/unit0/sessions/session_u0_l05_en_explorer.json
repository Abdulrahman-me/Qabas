              "segment_id": "seg_1",
              "spans": [
                {
                  "type": "text",
                  "text": "We suppose two powers neither restricted by the other."
                }
              ]
            },
            {
              "segment_id": "seg_2",
              "spans": [
                {
                  "type": "text",
                  "text": "We say they always agree."
                }
              ]
            },
            {
              "segment_id": "seg_3",
              "spans": [
                {
                  "type": "text",
                  "text": "Therefore we explained why disagreement is impossible."
                }
              ]
            }
          ]
        }
      }
    },
    {
