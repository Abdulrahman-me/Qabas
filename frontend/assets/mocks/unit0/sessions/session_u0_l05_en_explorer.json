      "block_id": "b_hook",
      "type": "hook",
      "situation": [
        {
          "type": "text",
          "text": "Imagine a match with two referees, each holding the same final authority."
        },
        {
          "type": "text",
          "text": " "
        },
        {
          "type": "text",
          "text": "One awards a goal; the other disallows it. No rule gives either decision priority."
        }
      ],
      "question": [
        {
          "type": "text",
          "text": "Can both decisions take effect together?"
        }
      ],
      "visual": {
        "kind": "scene",
