      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "synthesis_p0",
          "sentence": {
            "sentence_id": "synthesis_s0",
            "spans": [
              {
                "type": "text",
                "text": "The reasoning here depends on the creator’s independence, not on assuming all teamwork fails."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "synthesis_p1",
          "sentence": {
            "sentence_id": "synthesis_s1",
            "spans": [
              {
                "type": "text",
                "text": "If both need something to unite or decide between them, the question of independence moves to that thing."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "synthesis_p2",
          "sentence": {
            "sentence_id": "synthesis_s2",
            "spans": [
