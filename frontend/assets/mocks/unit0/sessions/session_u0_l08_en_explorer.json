      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "define_p0",
          "sentence": {
            "sentence_id": "define_s0",
            "spans": [
              {
                "type": "text",
                "text": "The paper’s age and its author are different claims; establishing age does not establish authorship."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "define_p1",
          "sentence": {
            "sentence_id": "define_s1",
            "spans": [
              {
                "type": "text",
                "text": "The seller’s confidence shows the seller’s position; it does not replace evidence of authorship."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "define_p2",
          "sentence": {
            "sentence_id": "define_s2",
            "spans": [
              {
                "type": "text",
                "text": "The claim might concern old paper, a particular author, or the contents being true."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "define_p3",
          "sentence": {
            "sentence_id": "define_s3",
            "spans": [
              {
                "type": "text",
                "text": "A clear question prevents evidence for a smaller claim from being transferred to a larger one without reason."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
