    {
      "block_id": "b_ex2",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l08_02",
        "type": "scenario",
        "concept_ids": [
          "con_u0_revelation_checking"
        ],
        "prompt": [
          {
            "type": "text",
            "text": "Which request advances the checking process?"
          }
        ],
        "time_limit_ms": null,
        "scoring": {
          "accuracy": true,
          "combo": true,
          "layer": "apply"
        },
        "framing": null,
        "payload": {
          "options": [
            {
              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "Confirm it came from an old box; that identifies the author."
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "Show a checkable record connecting the paper with the writer."
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "Tell me you are fully convinced of the attribution."
                }
              ]
            }
          ],
          "situation": [
            {
              "type": "text",
              "text": "The seller is confident, but the paper’s source is undocumented."
            }
          ]
        }
      }
    },
    {
      "block_id": "b_distinguish",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Look for what changes the judgment"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "distinguish_p0",
          "sentence": {
            "sentence_id": "distinguish_s0",
            "spans": [
              {
                "type": "text",
                "text": "Evidence fitting an original and an imitation equally does not distinguish them."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "distinguish_p1",
          "sentence": {
            "sentence_id": "distinguish_s1",
            "spans": [
              {
                "type": "text",
                "text": "Repeating the seller’s claim on another card adds no independent witness."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "distinguish_p2",
          "sentence": {
            "sentence_id": "distinguish_s2",
            "spans": [
              {
                "type": "text",
                "text": "A record can strengthen attribution if its source is established and it concerns this particular paper."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "distinguish_p3",
          "sentence": {
            "sentence_id": "distinguish_s3",
            "spans": [
              {
                "type": "text",
                "text": "An old appearance does not rule out imitation; evaluating specialist work requires knowing what was tested and how."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "distinguish_p4",
          "sentence": {
            "sentence_id": "distinguish_s4",
            "spans": [
              {
                "type": "text",
                "text": "You need not perform every check yourself; ask what supports the expert’s result."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_standards",
      "type": "predict",
      "prompt": [
        {
          "type": "text",
          "text": "Which position helps you remain fair?"
        }
      ],
      "options": [
        {
          "option_id": "opt_a",
          "spans": [
            {
              "type": "text",
              "text": "Look for what supports the claim and what could weaken it."
            }
          ]
        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "Check even what I lean toward believing."
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "Suspend judgment if the evidence is unclear."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "These checking approaches can be combined. Your feeling about the paper is not graded."
        }
      ],
      "visual": null
    },
    {
      "block_id": "b_transfer",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Apply the questions carefully"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "transfer_p0",
          "sentence": {
            "sentence_id": "transfer_s0",
            "spans": [
              {
                "type": "text",
                "text": "A revelation claim attributes a message to the creator; age or a positive effect alone does not establish that attribution."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "transfer_p1",
          "sentence": {
            "sentence_id": "transfer_s1",
            "spans": [
              {
                "type": "text",
                "text": "Ask: what exactly is claimed, how did it reach us, what supports it, and what could reveal an error?"
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "transfer_p2",
          "sentence": {
            "sentence_id": "transfer_s2",
            "spans": [
              {
                "type": "text",
                "text": "Consistency is useful to examine, but it does not establish a message’s source by itself."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "transfer_p3",
          "sentence": {
            "sentence_id": "transfer_s3",
            "spans": [
              {
                "type": "text",
                "text": "Good intentions do not suffice; a sincere speaker could misinterpret an experience."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "transfer_p4",
          "sentence": {
            "sentence_id": "transfer_s4",
            "spans": [
              {
                "type": "text",
                "text": "Fair examination allows the claim to be supported, weakened, or left open."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_ex3",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l08_03",
        "type": "order_steps",
        "concept_ids": [
          "con_u0_revelation_checking"
        ],
        "prompt": [
          {
            "type": "text",
            "text": "Put the checking process in order before judging."
          }
        ],
        "time_limit_ms": null,
        "scoring": {
          "accuracy": true,
          "combo": true,
          "layer": "apply"
        },
        "framing": null,
        "payload": {
          "presentation": "plain",
          "steps": [
            {
              "step_id": "st_1",
              "spans": [
                {
                  "type": "text",
                  "text": "Compare evidence and alternatives, seeking what could weaken the claim."
                }
              ],
              "secondary_label": null
            },
            {
              "step_id": "st_2",
              "spans": [
                {
                  "type": "text",
                  "text": "Specify the claim I am testing."
                }
              ],
              "secondary_label": null
            },
            {
              "step_id": "st_3",
              "spans": [
                {
                  "type": "text",
                  "text": "State a conclusion proportionate to what was established, or suspend judgment."
                }
              ],
              "secondary_label": null
            },
            {
              "step_id": "st_4",
              "spans": [
                {
                  "type": "text",
                  "text": "Examine the source, transmission and evidence of attribution."
                }
              ],
              "secondary_label": null
            }
          ]
        }
      }
    },
    {
      "block_id": "b_conclusion",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Three possible results"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "conclusion_p0",
          "sentence": {
            "sentence_id": "conclusion_s0",
            "spans": [
              {
                "type": "text",
                "text": "Insufficient evidence to establish a claim does not always establish its falsehood."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "conclusion_p1",
          "sentence": {
            "sentence_id": "conclusion_s1",
            "spans": [
              {
                "type": "text",
                "text": "Evidence contradicting a specific part of the claim can weaken it if verified and relevant."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "conclusion_p2",
          "sentence": {
