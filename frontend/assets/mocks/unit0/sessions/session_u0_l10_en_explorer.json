          "layer": "apply"
        },
        "framing": null,
        "payload": {
          "situation": [
            {
              "type": "text",
              "text": "Imagine a guide who deals honestly with others but has never visited the route you are asking about."
            }
          ],
          "options": [
            {
              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "Does the guide intend to report what he sincerely believes?"
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "How can the guide know this particular route?"
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "Is there a possible benefit behind the guide’s statement?"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "block_id": "b_u0_l10_06",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Look at conduct you can examine"
        }
      ],
      "style": "standard",
      "visual": {
        "kind": "scene",
        "key": null,
        "version": null,
        "params": {
          "beat": 2
