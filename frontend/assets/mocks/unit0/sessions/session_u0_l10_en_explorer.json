                  "type": "text",
                  "text": "In the imagined situation, the guide admitted a limit to his knowledge."
                }
              ],
              "secondary_label": null
            },
            {
              "item_id": "itm_2",
              "spans": [
                {
                  "type": "text",
                  "text": "Therefore he will never be mistaken."
                }
              ],
              "secondary_label": null
            },
            {
              "item_id": "itm_3",
              "spans": [
                {
                  "type": "text",
                  "text": "The guide explains payment before agreement."
                }
              ],
              "secondary_label": null
            },
            {
              "item_id": "itm_4",
              "spans": [
                {
                  "type": "text",
                  "text": "Therefore he is lying because he is paid."
                }
              ],
              "secondary_label": null
            }
          ]
        }
      }
    },
    {
      "block_id": "b_u0_l10_08",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "From a guide to a messenger claim"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l10_021",
            "spans": [
              {
                "type": "text",
                "text": "Islamic texts present messengers as humans who receive revelation and convey a message."
              }
            ],
            "source_ids": [
              "src_c_u0_l10_06"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l10_022",
            "spans": [
              {
                "type": "text",
                "text": "Examining a messenger claim requires evidence bearing on the claim itself, alongside character and honesty."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l10_023",
            "spans": [
              {
                "type": "text",
                "text": "Ask what was claimed, how the report reached us, what message is conveyed, and what evidence is offered."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l10_024",
            "spans": [
              {
                "type": "text",
                "text": "Examine consistent conduct and possible motives too, while keeping the message itself under examination."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_u0_l10_09",
      "type": "predict",
      "prompt": [
        {
          "type": "text",
          "text": "Which shortcut are you more tempted to use?"
        }
      ],
      "options": [
        {
          "option_id": "opt_a",
          "spans": [
            {
              "type": "text",
              "text": "Trust a confident voice."
            }
          ]
        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "Reject anyone making a large claim."
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "Hold judgement while understanding the evidence."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "Use this reflection to notice your habit; this personal choice has no right or wrong answer."
        }
      ],
      "visual": null
    },
    {
      "block_id": "b_u0_l10_10",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Compare explanations without attaching labels"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l10_026",
            "spans": [
              {
                "type": "text",
                "text": "A report could be deliberately false, sincerely mistaken, or accurate."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l10_027",
            "spans": [
              {
                "type": "text",
                "text": "These are examples of explanations to examine, rather than a complete list of every possibility."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l10_028",
            "spans": [
              {
                "type": "text",
                "text": "Ruling out deliberate deception alone does not establish that a report is accurate."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l10_029",
            "spans": [
              {
                "type": "text",
                "text": "Do not diagnose a person from a short report; examine what the evidence supports about the particular claim."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_u0_l10_11",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l10_03",
        "type": "true_false_reason",
        "concept_ids": [
          "con_u0_messenger_evaluation"
        ],
        "prompt": [
          {
            "type": "text",
            "text": "Judge the statement and choose the reason."
          }
        ],
        "time_limit_ms": null,
        "scoring": {
          "accuracy": true,
          "combo": true,
          "layer": "understand"
        },
        "framing": null,
        "payload": {
          "statement": [
            {
              "type": "text",
              "text": "If a claimant did not deliberately lie, the claim has been established."
            }
          ],
          "reasons": [
            {
              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "Because a confident voice is enough."
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "Because every mistake is deliberate deception."
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "Because a sincere mistake remains possible."
                }
              ]
            }
          ]
        }
      }
    },
    {
      "block_id": "b_u0_l10_12",
      "type": "callout",
      "variant": "note",
      "spans": [
        {
          "type": "text",
          "text": "Return to the questions rather than the labels: what evidence, what alternatives, and how much does it establish?"
        },
        {
          "type": "text",
          "text": " "
        },
        {
          "type": "text",
          "text": "When information is insufficient, write down what you need instead of filling the gap with a judgement."
        }
      ]
    },
    {
