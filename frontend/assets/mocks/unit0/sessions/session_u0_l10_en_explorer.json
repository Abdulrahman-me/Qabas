      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l10_015",
            "spans": [
              {
                "type": "text",
                "text": "A guide's refusal to overstate knowledge bears on that particular conduct, rather than on every future statement."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l10_016",
            "spans": [
              {
                "type": "text",
                "text": "A possible motive helps an examination, but does not make a report true or false by itself."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l10_017",
            "spans": [
              {
                "type": "text",
                "text": "An agreed payment for work does not equal dishonesty, and receiving no payment does not guarantee accuracy."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_4",
          "sentence": {
            "sentence_id": "s_u0_l10_018",
            "spans": [
              {
                "type": "text",
                "text": "Compare words with conduct, and ask for a clear account of what is being asked of you and why."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
