    {
      "block_id": "b_u0_l10_04",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Two questions that serve different purposes"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l10_011",
            "spans": [
              {
                "type": "text",
                "text": "Honestly reporting what you believe does not prevent the information itself from being mistaken."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l10_012",
            "spans": [
              {
                "type": "text",
                "text": "When trusting a report, ask about the reporter's honesty and their ability to know what they report."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l10_013",
            "spans": [
              {
                "type": "text",
                "text": "Ask whether the person honestly reports what they believe, then ask how they came to know it."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_u0_l10_05",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l10_01",
        "type": "scenario",
        "concept_ids": [
          "con_u0_messenger_evaluation"
        ],
        "prompt": [
          {
            "type": "text",
            "text": "Which question examines the gap in the guide’s knowledge of the route?"
          }
        ],
