    {
      "block_id": "b_u0_l10_14",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Trust begins with a more careful question"
        }
      ],
      "style": "summary",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "pt_1",
          "sentence": {
            "sentence_id": "s_u0_l10_036",
            "spans": [
              {
                "type": "text",
                "text": "When trusting a report, ask about the reporter's honesty and their ability to know what they report."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_2",
          "sentence": {
            "sentence_id": "s_u0_l10_037",
            "spans": [
              {
                "type": "text",
                "text": "A possible motive helps an examination, but does not make a report true or false by itself."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "pt_3",
          "sentence": {
            "sentence_id": "s_u0_l10_038",
            "spans": [
              {
                "type": "text",
                "text": "Examining a messenger claim requires evidence bearing on the claim itself, alongside character and honesty."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
