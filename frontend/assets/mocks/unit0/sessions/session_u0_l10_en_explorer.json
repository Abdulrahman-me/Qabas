              "spans": [
                {
                  "type": "text",
                  "text": "I examined a report about honesty and found its stated source."
                }
              ]
            },
            {
              "segment_id": "seg_2",
              "spans": [
                {
                  "type": "text",
                  "text": "The report shows no financial benefit."
