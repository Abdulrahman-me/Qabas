    {
      "block_id": "b_checks",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "The route needs examination"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "checks_p0",
          "sentence": {
            "sentence_id": "checks_s0",
            "spans": [
              {
                "type": "text",
                "text": "A transmitted message raises two different questions: did it come from its claimed source, and was its meaning preserved?"
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "checks_p1",
          "sentence": {
            "sentence_id": "checks_s1",
            "spans": [
              {
                "type": "text",
                "text": "A carrier’s personal suggestion does not become another’s message merely because the carrier came from far away."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "checks_p2",
          "sentence": {
            "sentence_id": "checks_s2",
            "spans": [
              {
                "type": "text",
                "text": "Many copies do not suffice if all repeat the same error from one source."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "checks_p3",
          "sentence": {
            "sentence_id": "checks_s3",
            "spans": [
              {
                "type": "text",
                "text": "Knowing the route clarifies what to examine. We have not judged any religious claim."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
    {
      "block_id": "b_possible",
      "type": "predict",
      "prompt": [
        {
          "type": "text",
          "text": "Do you distinguish a message’s possible arrival from proof of its arrival?"
        }
      ],
      "options": [
        {
          "option_id": "opt_a",
          "spans": [
            {
              "type": "text",
              "text": "I can see the difference."
            }
          ]
        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "I need another example."
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "I still have a question."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "Keep your response as it is. The example opens a possible route; evidence is needed when its occurrence is claimed."
