      ],
      "visual": null
    },
    {
      "block_id": "b_names",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "What do Muslims mean?"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "names_p0",
          "sentence": {
            "sentence_id": "names_s0",
            "spans": [
              {
                "type": "text",
                "text": "Now name the idea as Muslims present it, without asking you to accept its claim."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "names_p1",
          "sentence": {
            "sentence_id": "names_s1",
            "spans": [
              {
                "type": "text",
                "text": "Muslims use “revelation” for what God communicates to someone He chooses, rather than merely an idea a person has."
              }
            ],
            "source_ids": [
              "src_c07"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "names_p2",
          "sentence": {
            "sentence_id": "names_s2",
            "spans": [
              {
                "type": "text",
                "text": "In Islamic belief, a messenger is a person chosen by God to convey His message to people."
              }
            ],
            "source_ids": [
              "src_c08"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "names_p3",
          "sentence": {
