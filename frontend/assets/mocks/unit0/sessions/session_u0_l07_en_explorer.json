    {
      "block_id": "b_ex2",
      "type": "exercise",
      "exercise": {
        "exercise_id": "ex_u0_l07_02",
        "type": "multiple_choice",
        "concept_ids": [
          "con_u0_guidance_message"
        ],
        "prompt": [
          {
            "type": "text",
            "text": "Which question distinguishes carrying a message from giving an opinion?"
          }
        ],
        "time_limit_ms": null,
        "scoring": {
          "accuracy": true,
          "combo": true,
          "layer": "apply"
        },
        "framing": null,
        "payload": {
          "options": [
            {
              "option_id": "opt_a",
              "spans": [
                {
                  "type": "text",
                  "text": "Do people trust what you say?"
                }
              ]
            },
            {
              "option_id": "opt_b",
              "spans": [
                {
                  "type": "text",
                  "text": "Would the proposal help us?"
                }
              ]
            },
            {
              "option_id": "opt_c",
              "spans": [
                {
                  "type": "text",
                  "text": "Did you receive this from the sender or propose it yourself?"
