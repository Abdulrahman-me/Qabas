    {
      "block_id": "b_three_parts",
      "type": "teach",
      "eyebrow": null,
      "title": [
        {
          "type": "text",
          "text": "Three things, not one"
        }
      ],
      "style": "standard",
      "visual": null,
      "evidence": null,
      "points": [
        {
          "point_id": "three_parts_p0",
          "sentence": {
            "sentence_id": "three_parts_s0",
            "spans": [
              {
                "type": "text",
                "text": "The sender originates the message; the carrier delivers it. They can be different people."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "three_parts_p1",
          "sentence": {
            "sentence_id": "three_parts_s1",
            "spans": [
              {
                "type": "text",
                "text": "In this scenario, the official is the sender, the travel arrangements the message, and the traveler the carrier."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "three_parts_p2",
          "sentence": {
            "sentence_id": "three_parts_s2",
            "spans": [
              {
                "type": "text",
                "text": "Not meeting the sender does not make receiving the message impossible; a reliable route could carry it."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "three_parts_p3",
          "sentence": {
            "sentence_id": "three_parts_s3",
            "spans": [
              {
                "type": "text",
                "text": "Having a carrier establishes neither honesty nor faithful transmission; both require examination."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
