        },
        {
          "option_id": "opt_b",
          "spans": [
            {
              "type": "text",
              "text": "Receive a message through a reliable carrier."
            }
          ]
        },
        {
          "option_id": "opt_c",
          "spans": [
            {
              "type": "text",
              "text": "Use signals understood through prior agreement."
            }
          ]
        }
      ],
      "reveal": [
        {
          "type": "text",
          "text": "These are different hypothetical routes. The question is what each would require, not which one occurred."
