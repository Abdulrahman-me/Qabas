        {
          "point_id": "bridge_p1",
          "sentence": {
            "sentence_id": "bridge_s1",
            "spans": [
              {
                "type": "text",
                "text": "If the world had a creator, its effects could help us ask about its source."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "bridge_p2",
          "sentence": {
            "sentence_id": "bridge_s2",
            "spans": [
              {
                "type": "text",
                "text": "Reasoning toward a creator does not, by itself, specify everything that creator wants from human beings."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "bridge_p3",
          "sentence": {
            "sentence_id": "bridge_s3",
            "spans": [
              {
                "type": "text",
                "text": "Someone needing to know another’s intention needs access to that intention, rather than more guessing alone."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
          "point_id": "bridge_p4",
          "sentence": {
            "sentence_id": "bridge_s4",
            "spans": [
              {
                "type": "text",
                "text": "Here, guidance means direction about purpose and the way forward, not removing a person’s ability to think."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
      ]
    },
