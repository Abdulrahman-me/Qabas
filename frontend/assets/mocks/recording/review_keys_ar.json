  "ex_recording_quick_7": {
    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "أداء الصلاة كاملة كما شرعها الله."
      }
    ],
    "source_ids": []
  },
  "ex_recording_card_8": {
    "answer_key": null
  },
  "ex_recording_quick_8": {
    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "الصلاة الخامسة، في الليل بعد غياب الحمرة من الأفق."
