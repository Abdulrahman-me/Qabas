    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "الصلاة الثانية، حين تميل الشمس عن وسط السماء."
      }
    ],
    "source_ids": []
  },
  "ex_recording_card_3": {
    "answer_key": null
