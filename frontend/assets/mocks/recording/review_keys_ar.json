  "ex_recording_quick_3": {
    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "أن تكلّم الله وتطلب منه ما تحتاج، في أي وقت."
      }
    ],
    "source_ids": []
  },
  "ex_recording_card_4": {
    "answer_key": null
  },
  "ex_recording_quick_4": {
    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "أول صلاة في اليوم، مع أول ضوء قبل شروق الشمس."
      }
    ],
    "source_ids": []
  },
  "ex_recording_card_5": {
    "answer_key": null
  },
  "ex_recording_quick_5": {
    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "عمل طلبه الله من المسلم طلبًا لازمًا، وليس اختياريًا."
      }
    ],
    "source_ids": []
  },
  "ex_recording_card_6": {
    "answer_key": null
  },
  "ex_recording_quick_6": {
    "answer_key": {
      "option_id": "opt_0"
    },
    "explanation": [
      {
        "type": "text",
        "text": "كلام أو فعل ثابت عن النبي ﷺ، نُقل إلينا بطريق موثوق."
      }
    ],
    "source_ids": []
  },
  "ex_recording_card_7": {
    "answer_key": null
