                "text": "وسأل رجلٌ النبيَّ ﷺ: هل أمرك الله أن نصلي خمسًا في اليوم والليلة؟ فأجاب: نعم. فهي "
              },
              {
                "type": "term",
                "text": "فريضة",
                "term_id": "term_2adeb14614687765"
              },
              {
                "type": "text",
                "text": " على كل مسلم."
              }
            ],
            "source_ids": [
              "src_987c74f717c468e7"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_111c309fc0cfd2b7",
          "sentence": {
            "sentence_id": "sen_111c309fc0cfd2b7",
            "spans": [
              {
                "type": "text",
                "text": "و"
              },
              {
                "type": "term",
                "text": "الدعاء",
                "term_id": "term_af35bd90273f2d25"
              },
              {
                "type": "text",
                "text": " الحر مشروع في كل وقت، أما الصلاة فلها أوقات وطريقة معروفة."
              }
            ],
            "source_ids": [
              "src_987c74f717c468e7"
            ]
          },
          "visual_params": null
        }
      ]
    },
