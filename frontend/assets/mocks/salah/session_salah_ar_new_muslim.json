              "option_id": "opt_3b54c463e23d1c1c",
              "spans": [
                {
                  "type": "text",
                  "text": "لأن الدعاء وحده لا يكفي أبدًا"
                }
              ]
            },
            {
              "option_id": "opt_52792812691ee59b",
              "spans": [
                {
                  "type": "text",
                  "text": "الخمس للمتدينين جدًا فقط"
                }
              ]
            }
          ],
          "situation": [
            {
              "type": "text",
              "text": "صديقك يقول لك: «خمس مرات في اليوم كثير! لماذا لا تكفي مرة واحدة؟»"
            }
          ]
        }
      }
    },
