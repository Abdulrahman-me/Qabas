            "spans": [
              {
                "type": "text",
                "text": "فرض الله خمس صلوات في اليوم والليلة، كنهر على الباب يمحو الله به الخطايا الصغيرة."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        },
        {
