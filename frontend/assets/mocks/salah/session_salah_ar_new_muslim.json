          "sentence": {
            "sentence_id": "sen_c997e26c40baffcf",
            "spans": [
              {
                "type": "text",
                "text": "ترتيبها في يومك: الفجر، الظهر، العصر، المغرب، العشاء. وطريقتها تتعلمها خطوة خطوة في الدروس القادمة."
              }
            ],
            "source_ids": []
          },
          "visual_params": null
        }
