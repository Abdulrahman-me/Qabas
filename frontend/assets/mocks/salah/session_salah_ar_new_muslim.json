          "sentence": {
            "sentence_id": "sen_dfb3008225bed094",
            "spans": [
              {
                "type": "text",
                "text": "علّم النبي ﷺ سائلًا أوقات الصلاة بالفعل: صلّى معه يومين، ثم قال هذه الكلمة. فلكل صلاة وقت يبدأ وينتهي."
              }
            ],
            "source_ids": [
              "src_2bf61a3bc850596a"
            ]
          },
          "visual_params": null
        },
        {
          "point_id": "pt_6c08cc63f95f37d4",
          "sentence": {
            "sentence_id": "sen_6c08cc63f95f37d4",
            "spans": [
              {
                "type": "term",
                "text": "الفجر",
                "term_id": "term_eb164ebe0a82fe57"
              },
              {
                "type": "text",
                "text": ": مع أول ضوء في السماء، قبل شروق الشمس. ثم "
              },
              {
                "type": "term",
                "text": "الظهر",
                "term_id": "term_33eee0710eef852b"
              },
              {
                "type": "text",
                "text": ": حين تميل الشمس عن وسط السماء."
              }
            ],
            "source_ids": [
              "src_2bf61a3bc850596a"
            ]
          },
          "visual_params": {
            "highlight": 1
          }
        },
        {
          "point_id": "pt_61456c3ba4db5db7",
          "sentence": {
            "sentence_id": "sen_61456c3ba4db5db7",
            "spans": [
              {
                "type": "text",
                "text": "ثم "
              },
              {
                "type": "term",
                "text": "العصر",
                "term_id": "term_f2f6eba0f1d673c6"
              },
              {
                "type": "text",
                "text": " والشمس مرتفعة، ثم "
              },
              {
                "type": "term",
                "text": "المغرب",
                "term_id": "term_f7ced9adc6d3ac13"
              },
              {
                "type": "text",
                "text": " بعد الغروب، ثم "
              },
              {
                "type": "term",
                "text": "العشاء",
                "term_id": "term_59e0a7b720c83cd3"
              },
              {
                "type": "text",
                "text": " في الليل بعد غياب الحمرة من الأفق."
              }
            ],
            "source_ids": [
              "src_2bf61a3bc850596a"
            ]
          },
          "visual_params": {
            "highlight": 4
          }
        },
        {
          "point_id": "pt_cccce95410339b22",
          "sentence": {
            "sentence_id": "sen_cccce95410339b22",
            "spans": [
              {
                "type": "text",
                "text": "الأوقات تتبع الشمس، فتتغير ساعاتها بحسب المكان والموسم."
              }
            ],
            "source_ids": [
              "src_2bf61a3bc850596a"
            ]
          },
          "visual_params": null
        }
      ]
    },
