# Copy to backend/.env for local development (backend/.env is git-ignored).
# scripts/dev/create-dev-db.ps1 writes DATABASE_URL / TEST_DATABASE_URL / REDIS_URL for you.
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://qabas:<password>@127.0.0.1:5432/qabas_dev
TEST_DATABASE_URL=postgresql+asyncpg://qabas:<password>@127.0.0.1:5432/qabas_test
REDIS_URL=redis://127.0.0.1:6379/0

AUTH_TOKEN_PEPPER=<random secret>
AUTH_TOKEN_PEPPER_PREVIOUS=
STORAGE_SIGNING_KEY=<random secret>
WS_TICKET_TTL_SECONDS=60
SIGNED_URL_TTL_SECONDS=900

CONTRACT_REVISION=10
MIN_CLIENT_CONTRACT=10
MIN_APP_VERSION=0.0.0
CORS_ALLOWED_ORIGINS=[]
SYNTHETIC_LEAGUE_MEMBERS=false
RATE_LIMITS_PROFILE=default

STORAGE_BACKEND=local
CDN_BASE_URL=http://127.0.0.1:8000/media

# Source adapters (live/cache approval is controlled by content/sources/providers.yaml)
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
QURAN_FOUNDATION_API_BASE=https://apis.quran.foundation/content/api/v4
QURAN_FOUNDATION_SEARCH_BASE=https://apis.quran.foundation/search
QURAN_FOUNDATION_AUTH_URL=https://oauth2.quran.foundation/oauth2/token
QURAN_AUDIO_BASE_URL=https://verses.quran.com/
ISLAMHOUSE_API_KEY=
DORAR_BASE_URL=http://127.0.0.1:5000
# JSON argv array; actual server/tool mapping must be confirmed under O-03
TAFSIR_MCP_COMMAND=

# Recitation (Phase 10). The asr worker only: the converted model (scripts/convert_recitation_model.py).
# RECITATION_MODEL_PATH=var/models/whisper-base-ar-quran-ct2   (default; set only to move it)
# Admitted checks (queued + running) across API instances before 503; size it from measured throughput (O-03).
ASR_QUEUE_MAX=8
ASR_TIMEOUT_SECONDS=15

# Other providers (later phases)
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-4-5
STT_PROVIDER=
IMAGE_PROVIDER=
TTS_PROVIDER=
