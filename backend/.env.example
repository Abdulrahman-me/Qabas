# Copy to backend/.env for local development (backend/.env is git-ignored).
# scripts/dev/create-dev-db.ps1 writes DATABASE_URL / TEST_DATABASE_URL / REDIS_URL for you.
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://qabas:<password>@127.0.0.1:5432/qabas_dev
TEST_DATABASE_URL=postgresql+asyncpg://qabas:<password>@127.0.0.1:5432/qabas_test
REDIS_URL=redis://127.0.0.1:6379/0

AUTH_TOKEN_PEPPER=<random secret>
AUTH_TOKEN_PEPPER_PREVIOUS=
STORAGE_SIGNING_KEY=<random secret>
WS_TICKET_TTL_SECONDS=60
SIGNED_URL_TTL_SECONDS=900

CONTRACT_REVISION=10
MIN_CLIENT_CONTRACT=10
MIN_APP_VERSION=0.0.0
CORS_ALLOWED_ORIGINS=[]
SYNTHETIC_LEAGUE_MEMBERS=false
RATE_LIMITS_PROFILE=default

STORAGE_BACKEND=local
CDN_BASE_URL=http://127.0.0.1:8000/media

# Source adapters (live/cache approval is controlled by content/sources/providers.yaml)
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
QURAN_FOUNDATION_API_BASE=https://apis.quran.foundation/content/api/v4
QURAN_FOUNDATION_SEARCH_BASE=https://apis.quran.foundation/search
QURAN_FOUNDATION_AUTH_URL=https://oauth2.quran.foundation/oauth2/token
QURAN_AUDIO_BASE_URL=https://verses.quran.com/
ISLAMHOUSE_API_KEY=
DORAR_BASE_URL=http://127.0.0.1:5000
# JSON argv array; actual server/tool mapping must be confirmed under O-03
TAFSIR_MCP_COMMAND=

# Recitation (Phase 10). The asr worker only: the converted model (scripts/convert_recitation_model.py).
# RECITATION_MODEL_PATH=var/models/whisper-base-ar-quran-ct2   (default; set only to move it)
# Admitted checks (queued + running) across API instances before 503; size it from measured throughput (O-03).
ASR_QUEUE_MAX=8
ASR_TIMEOUT_SECONDS=15

# LLM and build-time media providers (selection/approval is separate from credentials)
ANTHROPIC_API_KEY=
LLM_MODEL_STRONG=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-4-5
# Per-request timeout and the SDK's bounded retries (429/5xx/transport). Models must be declared in
# content/llm/models.yaml; production refuses a model until its O-03 evaluation approves it.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
# Default token budget of one Lesson Factory run (all stages and retries); exceeding it fails the run with
# budget_exceeded (factory §13.1).
FACTORY_RUN_BUDGET_TOKENS=1500000
# Licensed reference recitations (O-06): directory with recordings.yaml (qabas.reference_recordings/1) and the
# approved reciter's whole-ayah MP3s. Unset = no reference recitation audio and no recitation activities.
# MEDIA_REFERENCE_RECORDINGS_DIR=
STT_PROVIDER=
STT_API_KEY=
# Approved provider's OpenAI-compatible API root; model and O-09 processing policy must match exactly.
STT_BASE_URL=
STT_MODEL=whisper-large-v3
FFMPEG_PATH=ffmpeg
RAQEEB_INPUT_TIMEOUT_SECONDS=10
RAQEEB_INPUT_MEMORY_MB=768
RAQEEB_INPUT_POLICY_PATH=content/raqeeb_input_policy.yaml
# Windows .env paths: use forward slashes or single quotes; double-quoted backslashes are escape sequences.
# Offline, digest-inventoried BAAI/bge-m3. uv sync --group embeddings; never downloads at runtime.
# RAQEEB_EMBEDDING_MODEL_DIR=
RAQEEB_MEMORY_ENABLED=true
RAQEEB_MEMORY_TTL_DAYS=30
# Optional separate Redis index when running an isolated parallel test checkout.
# TEST_REDIS_URL=
# Optional aggregate-only benchmark destination; configure privately, not in command arguments.
# BENCH_METRICS_DATABASE_URL=
IMAGE_PROVIDER=
IMAGE_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=
# content/media/policy.yaml pins approved models, licences, style/character inputs, scene references and renderer.
# Availability of a key never enables a pending provider. Optional narration never autoplays in the client.
MEDIA_TIMEOUT_SECONDS=120
MEDIA_NARRATION_ENABLED=false
MEDIA_PRONUNCIATION_ENABLED=false
# JSON argv array; only a separately approved, digest-pinned renderer/bridge may be configured.
SCENE_PREVIEW_COMMAND=
