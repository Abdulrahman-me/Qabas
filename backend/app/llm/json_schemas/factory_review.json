     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Exercise Id"
    },
    "kind": {
     "enum": [
      "unsupported_sentence",
      "fatwa_like",
      "consistency",
      "sensitive",
      "pedagogy",
      "belief_grading",
      "circular_reasoning",
      "localization",
      "scholarly_review"
     ],
     "title": "Kind",
     "type": "string"
    },
    "message": {
     "minLength": 1,
     "title": "Message",
     "type": "string"
    },
    "sentence_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Sentence Id"
    },
    "severity": {
     "enum": [
      "blocker",
      "warning",
      "info"
     ],
